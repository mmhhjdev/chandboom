# ---------------------------------------------------------------------------
# FRONTEND (Vite) variables: these are PUBLIC. Anything prefixed VITE_ is
# embedded in the JavaScript bundle that every visitor downloads.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Admin email shown in the admin UI (cosmetic). Real admin rights come from users.role = 'admin'.
VITE_ADMIN_EMAIL="admin@example.com"

# Google Analytics 4 measurement id (public by design)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---------------------------------------------------------------------------
# SERVER SECRETS: NEVER put these in a VITE_ variable or in the repo.
# Set them in Supabase Dashboard -> Edge Functions -> Secrets (or `supabase secrets set`):
#   GAPGPT_API_KEY=...            AI provider key (used only inside the ai-assistant function)
#   GAPGPT_BASE_URL=https://api.gapgpt.app/v1
#   AI_MODEL=gpt-4o-mini
#   AI_ALLOWED_ORIGINS=https://chandboom.ir     (REQUIRED, comma-separated, no wildcard)
#   SUPABASE_SERVICE_ROLE_KEY=...               (provided automatically in Edge Functions)
# ---------------------------------------------------------------------------
